# Smart Invest Solutions — backend configuration
#
# Copy this file to .env and fill in the values:   cp .env.example .env
# The server reads .env on startup (see internal/config/config.go); anything missing falls back to
# the defaults shown here. .env is git-ignored — never commit real credentials.

# ----------------------------------------------------------------- Database
# Local development: mongodb://localhost:27017
# MongoDB Atlas:     mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
#
# WARNING: whichever database this points at, pending migrations run against it the moment the
# server starts. Keep a separate database name for local work rather than pointing at production.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=smart_invest_solutions

# ------------------------------------------------------------------- Server
PORT=8080
# development = human-readable logs and debug level. Use production on a deployed server, where a
# weak JWT_SECRET is refused at startup.
ENV=development

# ---------------------------------------------------------------------- JWT
# Any long random string for local work; generate one with: openssl rand -base64 48
# In production this MUST be set to a strong unique value or the server refuses to start.
JWT_SECRET=change-me-for-local-development
JWT_EXPIRY_HOURS=24

# ------------------------------------------------------- File storage (Cloudinary)
# E-Vault uploads and product brochures. Leave empty locally: uploads are then refused with a clear
# "file storage is not configured" error instead of crashing.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ------------------------------------------------------------ Email (Resend)
# Leave RESEND_API_KEY empty locally — OTP and credential emails are then logged as failures and
# nothing is sent. The 6-digit codes still land in the database.
RESEND_API_KEY=
MAIL_ADDRESS=noreply@samiransamanta.in

# ------------------------------------------------------- Seed super admin account
# Created by migration 3 on first run against an empty database. Change these before any real
# deployment, and rotate the password after the first login.
SUPER_ADMIN_EMAIL=super@admin.com
SUPER_ADMIN_PASSWORD=superadmin123
